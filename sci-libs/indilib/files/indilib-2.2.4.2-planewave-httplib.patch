--- a/drivers/rotator/CMakeLists.txt
+++ b/drivers/rotator/CMakeLists.txt
@@ -130,5 +130,5 @@ SET(planewave_rotator_SRC
     planewave_rotator.cpp)
 
 add_executable(indi_planewave_rotator ${planewave_rotator_SRC})
